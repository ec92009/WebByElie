{
  "name": "web-by-elie-remotion",
  "private": true,
  "scripts": {
    "test": "node scripts/check-site.mjs && node scripts/check-wst-preparation.mjs && node --check assets/theme.js && node --check assets/i18n.js && node --check assets/wst-beacon.js && node --check scripts/generate-localized-pages.mjs && tsc --noEmit --pretty false",
    "service-videos:build": "npm --prefix Remotion_AG run render && node scripts/generate-service-voiceover.mjs",
    "remotion:preview": "remotion studio remotion/index.ts",
    "remotion:still": "remotion still remotion/index.ts WebByElieExplainer --frame=300 --output=outputs/web-by-elie-explainer-frame.png",
    "remotion:render": "remotion render remotion/index.ts WebByElieExplainer outputs/web-by-elie-explainer.mp4",
    "remotion:render:notebooklm": "remotion render remotion/index.ts NotebookLmExplainer outputs/web-by-elie-notebooklm-explainer.mp4",
    "remotion:still:reassembly": "remotion still remotion/index.ts WebPageReassembly --frame=220 --output=outputs/web-page-reassembly-frame.png",
    "remotion:render:reassembly": "remotion render remotion/index.ts WebPageReassembly assets/web-page-reassembly.mp4 --codec=h264 --crf=24",
    "remotion:still:seo": "remotion still remotion/index.ts SEOPageFlip --frame=220 --output=outputs/seo-page-flip-frame.png",
    "remotion:render:seo": "remotion render remotion/index.ts SEOPageFlip assets/seo-page-flip.mp4 --codec=h264 --crf=24",
    "remotion:still:aio": "remotion still remotion/index.ts AIORecommendations --frame=240 --output=outputs/aio-recommendations-frame.png",
    "remotion:render:aio": "remotion render remotion/index.ts AIORecommendations assets/aio-recommendations.mp4 --codec=h264 --crf=24",
    "remotion:still:savings": "remotion still remotion/index.ts SavingsCat --frame=250 --output=outputs/savings-cat-frame.png",
    "remotion:render:savings": "remotion render remotion/index.ts SavingsCat assets/savings-cat.mp4 --codec=h264 --crf=24"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.518",
    "@remotion/media": "^4.0.518",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.518"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3"
  }
}
